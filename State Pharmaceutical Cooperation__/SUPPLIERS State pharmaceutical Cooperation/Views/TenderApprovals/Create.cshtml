@model SUPPLIERS_State_pharmaceutical_Cooperation.Models.TenderApproval

@{
    ViewBag.Title = "Create Tender Approval";
}

<h2>Make Tender Approval</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <!-- Pre-filled fields -->
    <div class="form-group">
        Tender ID
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.TenderID, new { @class = "form-control", @readonly = "readonly", @Value = ViewBag.TenderID })
            @Html.ValidationMessageFor(model => model.TenderID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        Drug Name
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.DrugName, new { @class = "form-control", @readonly = "readonly", @Value = ViewBag.DrugName })
            @Html.ValidationMessageFor(model => model.DrugName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
      Quantity
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", @readonly = "readonly", @Value = ViewBag.Quantity })
            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Editable fields -->
    <div class="form-group">
      Supplier Name
        <div class="col-md-10">
            @Html.EditorFor(model => model.SupplierName, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SupplierName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
   Unit Price
        <div class="col-md-10">
            @Html.EditorFor(model => model.UnitPrice, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
       Delivery Date
        <div class="col-md-10">
            @Html.EditorFor(model => model.DeliveryDate, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
            @Html.ValidationMessageFor(model => model.DeliveryDate, "", new { @class = "text-danger" })
        </div>
    </div>





    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Create" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "TendersList", "Tenders")
</div>
