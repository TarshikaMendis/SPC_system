@model IEnumerable<PHARMACIES_State_pharmaceutical_Cooperation.Models.PharmacyNotification>

@{
    ViewBag.Title = "Pharmacy Notification List";
}

<h2>Pharmacy Notification List</h2>

<div class="notification-list">
    @foreach (var item in Model)
    {
        <div class="notification-item">
            <div class="notification-icon">
                <i class="fas fa-bell"></i>
            </div>
            <div class="notification-content">
                <h4 class="notification-title">@Html.DisplayFor(modelItem => item.Title)</h4>
                <p class="notification-message">@Html.DisplayFor(modelItem => item.Message)</p>
                <p class="notification-date">@Html.DisplayFor(modelItem => item.Datetime)</p>
            </div>
            <div class="notification-action">
                @Html.ActionLink("View Details", "Details", new { id = item.Id })
            </div>
        </div>
    }
</div>

<style>
    /* Notification List Styling */
    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin: 20px 0;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        background-color: #fff;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .notification-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
        }

    .notification-icon {
        font-size: 40px;
        color: #4CAF50;
        margin-right: 15px;
        display: flex;
        align-items: center;
    }

    .notification-content {
        flex: 1;
    }

    .notification-title {
        font-weight: bold;
        font-size: 1.1em;
        color: #333;
        margin: 0 0 5px 0;
    }

    .notification-message {
        color: #555;
        margin: 0 0 5px 0;
    }

    .notification-date {
        color: #888;
        font-size: 0.9em;
    }

    .notification-action {
        margin-left: 20px;
        align-self: center;
    }

        .notification-action a {
            color: #4CAF50;
            text-decoration: none;
            font-weight: bold;
        }

            .notification-action a:hover {
                text-decoration: underline;
            }
</style>

<!-- Add Font Awesome CDN -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
