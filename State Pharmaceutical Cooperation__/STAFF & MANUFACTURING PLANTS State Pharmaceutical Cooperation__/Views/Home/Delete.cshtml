@model STAFF___MANUFACTURING_PLANTS_State_Pharmaceutical_Cooperation__.Models.Inventory_Details

@{
    ViewBag.Title = "Delete Inventory";
}

<main class="delete-container">
    <h2>Are you sure you want to delete this inventory item?</h2>

    <dl class="inventory-details">
        <dt>Drug Name:</dt>
        <dd>@Model.Drug_Name</dd>

        <dt>Manufacturing Company:</dt>
        <dd>@Model.Manufacturing_Company</dd>

        <dt>Stock Quantity:</dt>
        <dd>@Model.Stock_Quantity</dd>

        <dt>Supplier Name:</dt>
        <dd>@Model.Supplier_Name</dd>

        <dt>Expiry Date:</dt>
        <dd>@Model.Expiry_Date</dd>

        <dt>Unit Price:</dt>
        <dd>@Model.Unit_Price</dd>

        <dt>Last Restock Date:</dt>
        <dd>@Model.Last_Restock_Date</dd>

        <dt>Batch Number:</dt>
        <dd>@Model.Batch_Number</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        @Html.ActionLink("Cancel", "Dashboard", null, new { @class = "btn btn-secondary" })
    }
</main>


