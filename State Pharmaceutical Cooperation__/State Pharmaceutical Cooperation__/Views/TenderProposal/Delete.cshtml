@model State_Pharmaceutical_Cooperation__.Models.TenderProposal

@{
    ViewBag.Title = "Delete Tender Proposal";
}

<h3>Are you sure you want to delete this</h3>
<div>
    <h4>Tender Proposal?</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Supplier Name:</dt>
        <dd>@Html.DisplayFor(model => model.SupplierName)</dd>

        <dt>Drug Name:</dt>
        <dd>@Html.DisplayFor(model => model.DrugName)</dd>

        <dt>Quantity:</dt>
        <dd>@Html.DisplayFor(model => model.Quantity)</dd>

        <dt>Unit Price:</dt>
        <dd>@Html.DisplayFor(model => model.UnitPrice)</dd>

        <dt>Total Cost:</dt>
        <dd>@Html.DisplayFor(model => model.TotalCost)</dd>

        <dt>Proposed Delivery Date:</dt>
        <dd>@Html.DisplayFor(model => model.ProposedDeliveryDate)</dd>

        <dt>Status:</dt>
        <dd>@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
    }
    <br>
    <p>@Html.ActionLink("Back to List", "TenderProposalList")</p>
</div>