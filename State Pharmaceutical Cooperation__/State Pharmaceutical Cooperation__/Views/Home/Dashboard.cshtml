@{
    ViewBag.Title = "Dashboard";
}
<main class="dashboard-container">
    <!-- Overview of SPC -->
    <section class="welcome-section" aria-labelledby="spcOverviewTitle">
        <h1 id="spcOverviewTitle">Admin Dashboard</h1>
        
    </section>

    <!-- Navigation Buttons -->
    <section class="navigation-section">
        
        <div class="button-container">
            <a href="@Url.Action("TenderManagement", "Home")" class="btn btn-indigo">
                <i class="fas fa-file-contract"></i> Tenders Section 
            </a>
            <a href="@Url.Action("Inventory_DetailsList", "Inventory_Details")" class="btn btn-indigo">
                <i class="fas fa-boxes"></i> Stock Details
            </a>
            <a href="@Url.Action("Orders_DetailsList", "Orders_Details")" class="btn btn-indigo">
                <i class="fas fa-receipt"></i> Orders
            </a>
            <a href="@Url.Action("UserManagement", "Home")" class="btn btn-indigo">
                <i class="fas fa-user-shield"></i> Users
            </a>
        </div>
    </section>
</main>

<style>
    /* General Styling */
    .dashboard-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    h1, h2 {
        text-align: center;
        color: #143b45;
    }

    h1 {
        font-size: 2.5rem;
        margin-bottom: 20px;
        font-weight: 700;
    }

    h2 {
        font-size: 1.8rem;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .lead {
        font-size: 1.1em;
        text-align: center;
        color: #555; /* Dark gray for text */
        margin-bottom: 30px;
    }

    /* Navigation Buttons */
    .button-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
        font-size: 16px;
        text-decoration: none;
        color: navajowhite;
        border-radius: 12px;
        background-color:gray;
        transition: all 0.3s ease;
    }

        .btn i {
            font-size: 28px;
            margin-bottom: 10px;
        }

        .btn:hover {
            background-color: orange; /*  on hover */
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

    /* Button Colors */
    .btn-indigo {
        background-color: black;
    }

    /* Add a subtle gradient to the body */
    body {
        background: gray;
        font-family: 'Roboto', sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
    }

    /* Footer Styling */
    footer {
        text-align: center;
        color: #4B0082; /* Dark purple text */
        margin-top: 30px;
        font-size: 0.9rem;
    }

        footer p {
            margin: 0;
        }
</style>

<!-- Add Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<!-- Add Font Awesome CDN -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">