@{
    ViewBag.Title = "Tender Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPC Tender Management Section</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <style>
        /* General Styling */
        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(135deg, #E6E6FA, #D8BFD8); /* Light purple gradient */
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95); /* Semi-transparent white */
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1, h2 {
            text-align: center;
            color: #2f2a4a; 
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            font-weight: 700;
        }

        h2 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .lead {
            font-size: 1.1em;
            text-align: center;
            color: #555; /* Dark gray for text */
            margin-bottom: 30px;
        }

        /* Navigation Buttons */
        .button-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            font-size: 16px;
            text-decoration: none;
            color: #fff;
            border-radius: 12px;
            background-color: #9370DB; /* Medium purple */
            transition: all 0.3s ease;
        }

            .btn i {
                font-size: 28px;
                margin-bottom: 10px;
            }

            .btn:hover {
                background-color: #7B68EE; /* Slightly darker purple on hover */
                transform: translateY(-3px);
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }


        .btn-purple {
            background-color: #8F87B9; /* Light Purple */
        }

            .btn-purple:hover {
                background-color: #A8A2D1; /* Darker Light Purple on hover */
            }


    </style>
</head>
<body>
    <main class="dashboard-container">
        <!-- Overview of SPC -->
        <section class="welcome-section" aria-labelledby="spcOverviewTitle">
            <h1 id="spcOverviewTitle">Tender Management Section</h1>
            
        </section>

        <!-- Navigation Buttons -->
        <section class="navigation-section">
            
            <div class="button-container">
                <a href="@Url.Action("TenderList", "Tender", new { area = "" })" class="btn btn-purple">
                    <i class="fas fa-folder-open"></i>
                    View Tenders
                </a>

                <a href="@Url.Action("TenderApprovalsList", "TenderApproval", new { area = "" })" class="btn btn-purple">
                    <i class="fas fa-check-circle"></i>
                    Approved Suppliers
                </a>
                <a href="@Url.Action("TenderProposalList", "TenderProposal", new { area = "" })" class="btn btn-purple">
                    <i class="fas fa-clipboard-list"></i>
                    Manage Proposals
                </a>


            </div>
        </section>
    </main>
</body>
</html>