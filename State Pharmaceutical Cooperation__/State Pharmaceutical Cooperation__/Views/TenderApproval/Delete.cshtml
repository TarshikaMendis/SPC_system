@model State_Pharmaceutical_Cooperation__.Models.TenderApproval

@{
    ViewBag.Title = "Delete Tender Approval";
}

<h2>Delete Tender Approval</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="dl-horizontal">
        
        <dt>Drug Name:</dt>
        <dd>@Model.DrugName</dd>

        <dt>Quantity:</dt>
        <dd>@Model.Quantity</dd>

        <dt>Supplier Name:</dt>
        <dd>@Model.SupplierName</dd>

        <dt>Unit Price:</dt>
        <dd>@Model.UnitPrice.ToString("C")</dd>

        <dt>Total Cost:</dt>
        <dd>@Model.TotalCost.ToString("C")</dd>

        <dt>Delivery Date:</dt>
        <dd>@Model.DeliveryDate.ToString("yyyy-MM-dd")</dd>

        <dt>Status:</dt>
        <dd>@Model.Status</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Cancel", "TenderApprovalsList", null, new { @class = "btn btn-default" })
    }
</div>