@model State_Pharmaceutical_Cooperation__.Models.StaffManufacturing

@{
    ViewBag.Title = "Delete Staff or Manufacturing Plant";
}

<h3>Are you sure you want to delete this Staff?</h3>
<div>
   
    <hr />
    <dl class="dl-horizontal">
        <dt>Email</dt>
        <dd>@Html.DisplayFor(model => model.email)</dd>
        <dt>Password</dt>
        <dd>@Html.DisplayFor(model => model.password)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
    }
    <br>
    <p>@Html.ActionLink("Back to List", "StaffManufacturingList")</p>
</div>
