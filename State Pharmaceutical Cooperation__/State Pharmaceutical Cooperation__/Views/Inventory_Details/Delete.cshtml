@model State_Pharmaceutical_Cooperation__.Models.Inventory_Details

@{
    ViewBag.Title = "Delete Inventory Item";
}


<h3>Are you sure you want to delete this item?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt> Drug Name
        <dt />
        <dd>@Html.DisplayFor(model => model.Drug_Name)</dd>


        <dt>Manufacturing Company</dt>
        <dd>@Html.DisplayFor(model => model.Manufacturing_Company)</dd>

        <dt>Supplier Name</dt>
        <dd>@Html.DisplayFor(model => model.Supplier_Name)</dd>

        <dt>Stock Quantity</dt>
        <dd>@Html.DisplayFor(model => model.Stock_Quantity)</dd>

        <dt>Unit Price</dt>
        <dd>@Html.DisplayFor(model => model.Unit_Price)</dd>

        <dt>Batch Number</dt>
        <dd>@Html.DisplayFor(model => model.Batch_Number)</dd>


        <dt>Expiry Date</dt>
        <dd>@Html.DisplayFor(model => model.Expiry_Date)</dd>



        <dt>Last Restock Date</dt>
        <dd>@Html.DisplayFor(model => model.Last_Restock_Date)</dd>


    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            @Html.ActionLink("Back to List", "Inventory_DetailsList")
        </div>
    }
</div>