@model State_Pharmaceutical_Cooperation__.Models.Tender

@{
    ViewBag.Title = "Delete Tender";
}

<h3>Are you sure you want to delete this Tender?</h3>
<div>
    
    <hr />
    <dl class="dl-horizontal">

        <dt>Tender ID:</dt>
        <dd>@Html.DisplayFor(model => model.TenderID)</dd>

        <dt>Drug Name:</dt>
        <dd>@Html.DisplayFor(model => model.DrugName)</dd>

        <dt>Quantity Required:</dt>
        <dd>@Html.DisplayFor(model => model.QuantityRequired)</dd>

        <dt>Tender Description:</dt>
        <dd>@Html.DisplayFor(model => model.TenderDescription)</dd>

        <dt>Published Date:</dt>
        <dd>@Html.DisplayFor(model => model.PublishedDate)</dd>

        <dt>Closing Date:</dt>
        <dd>@Html.DisplayFor(model => model.ClosingDate)</dd>

        <dt>Status:</dt>
        <dd>@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
    }
    <br>
    <p>@Html.ActionLink("Back to List", "TenderList")</p>
</div>