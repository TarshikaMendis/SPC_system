@model State_Pharmaceutical_Cooperation__.Models.Tender

@{
    ViewBag.Title = "Create Tender";
}

<h2>Add Tender</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        <div class="form-group">
          Drug Name
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.DrugName, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
         Quantity Required
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.QuantityRequired, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
          Tender Description
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.TenderDescription, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
           Published Date
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.PublishedDate, new { @class = "form-control", type = "datetime-local" })
            </div>
        </div>

        <div class="form-group">
          Closing Date
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.ClosingDate, new { @class = "form-control", type = "datetime-local" })
            </div>
        </div>

        <div class="form-group">
           Status
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.Status, new { @class = "form-control" })
            </div>
        </div>
        <br>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>
    </div>
}
<br>
<p>@Html.ActionLink("Back to List", "TenderList")</p>