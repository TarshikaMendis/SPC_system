@model State_Pharmaceutical_Cooperation__.Models.Supplier

@{
    ViewBag.Title = "Delete Supplier";
}

<h3>Are you sure you want to delete this Supplier?</h3>
<div>
    
    <hr />
    <dl class="dl-horizontal">
        <dt>Email</dt>
        <dd>@Html.DisplayFor(model => model.Email)</dd>
        <dt>Password</dt>
        <dd>@Html.DisplayFor(model => model.Password)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
    }
    <br>
    <p>@Html.ActionLink("Back to List", "SupplierList")</p>
</div>